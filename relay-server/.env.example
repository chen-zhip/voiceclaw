# ── Required ──────────────────────────────────────────────────────────────────

# Gemini API key — used for both Gemini Live realtime sessions AND history summarization.
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API key clients must send to connect to this relay server
# Generate one: openssl rand -hex 24
RELAY_API_KEY=

# Brain agent gateway auth token (formerly OPENCLAW_GATEWAY_AUTH_TOKEN)
# If using OpenClaw, found in ~/.openclaw/openclaw.json under gateway.auth.token
BRAIN_GATEWAY_AUTH_TOKEN=

# STT/TTS mode provider keys. These can instead be sent in session.config.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# Thinking capture is privacy-sensitive and disabled unless exactly "enabled".
# VOICECLAW_THINKING_CAPTURE=enabled
# Default: ~/.voiceclaw/thinking
# VOICECLAW_THINKING_DIR=

# ── Optional ─────────────────────────────────────────────────────────────────

# xAI API key — used for both Grok Voice realtime sessions AND history summarization.
# Get yours at https://console.x.ai
# XAI_API_KEY=xai-...

# Server port (default: 8080)
# PORT=8080

# Brain agent gateway URL -- any OpenAI-compatible endpoint (formerly OPENCLAW_GATEWAY_URL)
# BRAIN_GATEWAY_URL=http://localhost:18789

# Brain agent workspace path (used in system instructions; formerly OPENCLAW_WORKSPACE)
# BRAIN_WORKSPACE=

# Session rotation interval in ms (default: 50 minutes)
# ROTATION_INTERVAL_MS=3000000

# Langfuse tracing (optional — relay runs fine without these)
# Cloud: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
# Self-hosted: point at your own deployment
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Dual-export OTel spans to a local tracing-ui collector alongside Langfuse.
# When set, the relay posts OTLP-HTTP to this URL in addition to Langfuse.
# TRACING_UI_COLLECTOR_URL=http://127.0.0.1:4318/v1/traces

# Tavily API key for the web_search tool. When set (here OR in the desktop's
# Settings → Web Search field), the realtime model gets a fast public-web
# lookup tool alongside ask_brain. Get a key at https://tavily.com.
# TAVILY_API_KEY=tvly-...

# TAVILY_ENDPOINT — override the Tavily API endpoint (test/debug only; defaults to https://api.tavily.com/search)
# TAVILY_ENDPOINT=
